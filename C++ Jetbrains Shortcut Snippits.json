	"Class": {
		"prefix": "class",
		"body": [
			"class ${1:ClassName} {",
			"private:",
			"\t$2",
			"public:",
			"\t${1:ClassName}() {",
			"\t\t$3",
			"\t}",
			"\t$0",
			"};"
		],
		"description": "Create a class"
	},
	"Struct": {
		"prefix": "struct",
		"body": ["struct ${1:StructName} {", "\t$0", "};"],
